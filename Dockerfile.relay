FROM node:22-alpine AS web-build

WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY apps/web apps/web
RUN npm --workspace apps/web run build

FROM golang:1.24-alpine AS go-build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/codex-relay-server cmd/codex-relay-server
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/codex-relay-server ./cmd/codex-relay-server

FROM alpine:3.21

RUN addgroup -S codex && adduser -S -G codex -h /app codex
WORKDIR /app
ARG CODEX_LINK_VERSION=0.2.3
LABEL org.opencontainers.image.version=$CODEX_LINK_VERSION
COPY --from=go-build /out/codex-relay-server /app/codex-relay-server
COPY --from=web-build /src/apps/web/dist /app/web
RUN mkdir -p /data && chown -R codex:codex /app /data
USER codex
EXPOSE 8787
ENV PORT=8787 DATA_DIR=/data WEB_DIR=/app/web ALLOW_REGISTRATION=true
ENTRYPOINT ["/app/codex-relay-server"]
